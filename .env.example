# =============================================
# AutomaticNotes - 环境变量配置
# =============================================
# 使用前：
#   cp .env.example .env
#   然后编辑 .env 填入你的真实 Key
# =============================================

# ---------- MySQL（本地开发用 root 即可）----------
MYSQL_PASSWORD=root

# ---------- 华为云 OBS（必填）----------
# 1. 在华为云 OBS 控制台创建 Bucket（存储策略选"公共读"，单 AZ）
#    https://console.huaweicloud.com/console/?locale=zh-cn#/obs/manager/overview
# 2. 在华为云 IAM 创建用户，获取 AccessKey
#    https://console.huaweicloud.com/console/?locale=zh-cn#/iam/users
HUAWEICLOUD_OBS_ACCESS_KEY_ID=your-obs-access-key-id
HUAWEICLOUD_OBS_ACCESS_KEY_SECRET=your-obs-access-key-secret
HUAWEICLOUD_OBS_BUCKET_NAME=your-bucket-name
HUAWEICLOUD_OBS_ENDPOINT=obs.cn-east-3.myhuaweicloud.com

# ---------- DashScope 通义千问（必填）----------
# 1. 打开 https://dashscope.console.aliyun.com/ 开通服务
# 2. API-KEY 管理 → 创建 API Key
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ---------- 阿里云通义听悟 ASR（必填）----------
# 1. RAM 控制台创建用户（勾选 OpenAPI 调用访问），授权 AliyunTingwuFullAccess
#    https://ram.console.aliyun.com/
# 2. 通义听悟控制台创建项目，获取 AppKey（回调 URL 留空即可）
#    https://nls-portal.console.aliyun.com/tingwu/overview
ASR_ALIYUN_ACCESS_KEY_ID=LTAI5t...
ASR_ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-secret
ASR_ALIYUN_APP_KEY=your-tingwu-app-key

# ---------- JWT（可选）----------
# 不设则使用默认值
# JWT_SECRET=your-jwt-secret-base64
